[Unit]
Description=Aegis Quant (v0.2.0-rc2 Rust Native) Autonomous Web3 DEX Quantitative Trading Platform
After=network-online.target chronyd.service
Wants=network-online.target chronyd.service

[Service]
Type=simple
User=fedora
Group=fedora
WorkingDirectory=/home/fedora/aegis
Environment="RUST_LOG=info"
LoadCredential=aegis_master_key:/home/fedora/aegis/data/.aegis_master_key
ExecStart=/home/fedora/aegis/bin/aegis-quant --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
