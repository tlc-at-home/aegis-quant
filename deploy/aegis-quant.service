[Unit]
Description=Aegis Quant (v0.2.0-rc2) Autonomous Web3 DEX Quantitative Trading Platform
After=network-online.target chronyd.service
Wants=network-online.target chronyd.service

[Service]
Type=simple
User=fedora
Group=fedora
WorkingDirectory=/home/fedora/aegis
Environment="PYTHONUNBUFFERED=1"
Environment="PYTHONPATH=/home/fedora/aegis"
LoadCredential=aegis_master_key:/home/fedora/aegis/data/.aegis_master_key
ExecStart=/usr/bin/bash -c "exec /home/fedora/aegis/venv/bin/python -m engine.main"
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
