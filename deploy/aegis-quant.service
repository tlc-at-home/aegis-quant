[Unit]
Description=Aegis Quant v2.0 Autonomous Web3 DEX Quantitative Trading Platform (Hyperliquid L1 + MariaDB 13.0)
After=network-online.target chronyd.service mariadb.service
Wants=network-online.target chronyd.service mariadb.service

[Service]
Type=simple
User=fedora
Group=fedora
WorkingDirectory=/home/fedora/aegis
Environment="RUST_LOG=info"
Environment="AEGIS_DB_URL=mysql://aegis:aegis_v2_local@127.0.0.1:3306/aegis_quant"
LoadCredential=aegis_master_key:/home/fedora/aegis/data/.aegis_master_key
ExecStart=/home/fedora/aegis/bin/aegis-quant --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
LimitNOFILE=65535

# Systemd Service Hardening
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/fedora/aegis/data -/home/fedora/aegis/logs -/var/lib/mysql
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
