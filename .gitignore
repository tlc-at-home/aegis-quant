# Rust build artifacts & compiled release binary
/target/
/bin/

# Legacy Python virtual environments & caches
venv/
.venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/

# SQLite WAL database & local master key (contains live credentials and encryption keys)
data/*.db
data/*.db-shm
data/*.db-wal
data/.aegis_master_key
.aegis_master_key
**/.aegis_master_key
*.key

# Runtime logs & temporary files (all config & credentials live exclusively in SQLite system_config)
logs/*.log
.env
Platform_Specs.md
blueprint-*.md
.Trash-*/
